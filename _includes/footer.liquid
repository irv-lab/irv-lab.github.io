{% capture footer_contents %}
  <div class="footer-grid" style="display:flex; gap:2rem;">
    <div class="footer-col" style="flex:1;">
      <div class="footer-logo">
        <img src="/assets/img/slogan_2.png" alt="Logo" style="height: 50px; width: auto;"/>
      </div>
    </div>
    <div class="footer-col" style="flex:1;">
      <div style="color: var(--global-footer-text-color);">{{ site.subtitle }}</div>
      <div style="color: var(--global-footer-text-color);">Department of Computer Engineering</div>
      <div style="color: var(--global-footer-text-color);">Gachon University</div>
    </div>
    <div class="footer-col" style="flex:1;">
        <div style="color: var(--global-footer-text-color);">{{ site.footer_address1 }}</div>
        <div style="color: var(--global-footer-text-color);">{{ site.footer_address2 }}</div>
        <div style="color: var(--global-footer-text-color);">{{ site.footer_address3 }}</div>
    </div>
  </div>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
