---
layout: page
---
{% for item in page.contents %}
  <section class="join-section">
    {% if item.level == 3 %}
      <h3 class="item-title" style="font-weight: bold; color: var(--global-theme-color);">{{ item.title }}</h3>
    {% elsif item.level == 4 %}
      <h4 class="item-title" style="font-weight: bold; color: var(--global-theme-color);">{{ item.title }}</h4>
    {% endif %}
    {{ item.text | markdownify }}
  </section>
{% endfor %}
{{ content }}
