---
layout: page
---
<style>
  @media (max-width: 800px) {
    .row {
      grid-template-columns: 1fr !important;
    }
  }
</style>
<div class="post">
  <article>
    {% if page.profiles %}
      {% assign categories = "Faculty,PhD,Master,Undergraduate" | split: "," %}
      {% for category in categories %}
        {% assign filtered_profiles = page.profiles | where: "category", category %}
        {% if filtered_profiles.size > 0 %}
          <h2 style="clear:both; margin-top:2rem;">{{ category }}</h2>
          <div class="row" style="display:grid; grid-template-columns: repeat(2, 1fr); gap:2rem; margin-bottom:2rem;">
            {% for profile in filtered_profiles %}
              <div class="col" style="box-sizing: border-box; display: flex; align-items: flex-start; gap: 1rem;">
                {% if profile.image %}
                  <img
                    src="{{ profile.image | prepend: 'assets/img/profiles/' | relative_url }}"
                    alt="{{ profile.name }}"
                    style="width:100px; height:auto; border-radius:5%;" />
                {% else %}
                  <img
                    src="{{ 'assets/img/profiles/blank.jpg' | relative_url }}"
                    alt="{{ profile.name }}"
                    style="width:100px; height:auto; border-radius:5%;" />
                {% endif %}
                <div class="profile-details" style="text-align:left;">
                  <div class="profile-name" style="font-weight: bold; color: var(--global-theme-color);">{{ profile.name }}</div>
                  <div class="profile-info">{{ profile.info }}</div>
                  <div class="profile-email" style="font-size:0.9em; font-weight: bold; color:#555;">{{ profile.email }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </article>
</div>
